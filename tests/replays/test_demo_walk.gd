# Replay regression test generated by godot-replay from demo-walk.
# Recorded on game version 0.1.0 (255747f), Godot 4.7.2-stable (official), ticks 1095..1800.
# Tester note: Scripted demo walk: lamp toggled, bumped by the wanderer once
extends GdUnitTestSuite

const BUNDLE := "res://tests/replays/demo-walk"
const SCENE := "res://example/main.tscn"


func test_replay_demo_walk() -> void:
	var runner := scene_runner(SCENE)
	var result: ReplayResult = await ReplayTestKit.replay(runner.scene(), BUNDLE)
	assert_bool(result.ok).override_failure_message(result.text()).is_true()
	var state := result.final_state
	assert_that(ReplayTestKit.field(state, "room")).is_equal("left")
	assert_that(ReplayTestKit.field(state, "lamp_on")).is_equal(true)
	assert_float(float(ReplayTestKit.field(state, "bumps"))).is_equal_approx(1.0, 0.01)
	assert_int((ReplayTestKit.field(state, "player.position") as Array).size()).is_equal(2)
	assert_float(float(ReplayTestKit.field(state, "player.position.0"))).is_equal_approx(308.924, 0.01)
	assert_float(float(ReplayTestKit.field(state, "player.position.1"))).is_equal_approx(165.0396, 0.01)
