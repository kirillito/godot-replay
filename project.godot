; Engine configuration file.
; This project is the godot-replay development and example project.
; Only addons/godot_replay/ is shipped to users.

config_version=5

[application]

config/name="godot-replay example"
config/version="0.1.0"
run/main_scene="res://example/main.tscn"
config/features=PackedStringArray("4.7")

[display]

window/size/viewport_width=640
window/size/viewport_height=240
window/size/window_width_override=1280
window/size/window_height_override=480
window/stretch/mode="canvas_items"

[editor_plugins]

enabled=PackedStringArray()

