class_name ReplayTestKit
extends RefCounted
## Helpers for replay regression tests. Framework-agnostic: gdUnit4 tests
## generated by --make-test call these.


## Replays [param bundle_path] in [param scene], which must contain a
## ReplayRecorder with its adapter set (the game's debug layer adds it).
## [param speed] must be a power of two: physics then runs that many times
## faster with a bit-identical delta.
static func replay(scene: Node, bundle_path: String, speed := 4) -> ReplayResult:
	var recorder := ReplayRecorder.find_under(scene)
	if recorder == null:
		return ReplayResult.error("no ReplayRecorder under %s; is the debug layer added?" % scene.name)
	if not recorder.start_replay(bundle_path, {"speed": speed}):
		return recorder.last_result
	var tree := scene.get_tree()
	var result: ReplayResult = await recorder.replay_finished
	# Let the signal finish emitting so callers may free the scene right away.
	await tree.process_frame
	return result


## Reads a dotted path ("player.position", "items.0.id") from a state dump.
static func field(state: Dictionary, path: String) -> Variant:
	return ReplayDiff.field(state, path)
