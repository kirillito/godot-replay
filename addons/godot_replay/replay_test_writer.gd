class_name ReplayTestWriter
extends RefCounted
## Turns a bundle into a gdUnit4 regression test that replays it and asserts
## no divergence plus the final-state fields the developer names.

const MAX_STATE_LINES := 40


## Copies the bundle next to [param test_path] (unless it is already there),
## writes the test, and returns a short report ("TEST ERROR: ..." on failure).
static func write(bundle: ReplayBundle, test_path: String, final_state: Dictionary, fields: PackedStringArray) -> String:
	var test_res := _to_res(test_path)
	if test_res.is_empty():
		return "TEST ERROR: %s is outside the project; tests must live under res://" % test_path
	if not test_res.ends_with(".gd"):
		return "TEST ERROR: the test path must end in .gd"
	var source_path := bundle.path
	var bundle_res := test_res.get_base_dir().path_join(source_path.trim_suffix("/").get_file())
	if ProjectSettings.globalize_path(bundle_res).simplify_path() != ProjectSettings.globalize_path(source_path).simplify_path():
		bundle.path = bundle_res
		var err := bundle.save_in_place()
		bundle.path = source_path
		if err != OK:
			return "TEST ERROR: cannot copy the bundle to %s (%s)" % [bundle_res, error_string(err)]
	var file := FileAccess.open(test_res, FileAccess.WRITE)
	if file == null:
		return "TEST ERROR: cannot write %s (%s)" % [test_res, error_string(FileAccess.get_open_error())]
	file.store_string(source(bundle, bundle_res, final_state, fields))
	file.close()
	return "wrote %s (bundle: %s)" % [test_res, bundle_res]


## The test's GDScript source.
static func source(bundle: ReplayBundle, bundle_res: String, final_state: Dictionary, fields: PackedStringArray) -> String:
	var manifest := bundle.manifest
	var game: Dictionary = manifest.get("game", {})
	var name := bundle.bundle_name()
	var lines := PackedStringArray([
		"# Replay regression test generated by godot-replay from %s." % name,
		"# Recorded on game version %s, Godot %s, ticks %d..%d." % [
			game.get("version", "?"), manifest.get("engine", "?"), bundle.start_tick(), bundle.end_tick()],
	])
	var note := str(manifest.get("note", ""))
	if not note.is_empty():
		lines.append("# Tester note: " + note.replace("\n", " "))
	lines.append_array([
		"extends GdUnitTestSuite",
		"",
		"const BUNDLE := %s" % JSON.stringify(bundle_res),
		"const SCENE := %s" % JSON.stringify(str(manifest.get("scene", ""))),
		"",
		"",
		"func test_replay_%s() -> void:" % _identifier(name),
		"\tvar runner := scene_runner(SCENE)",
		"\tvar result: ReplayResult = await ReplayTestKit.replay(runner.scene(), BUNDLE)",
		"\tassert_bool(result.ok).override_failure_message(result.text()).is_true()",
		"\tvar state := result.final_state",
	])
	if fields.is_empty():
		lines.append("\t# TODO: assert the fixed behaviour on the final state_dump(), e.g.")
		lines.append("\t# assert_that(ReplayTestKit.field(state, \"some.field\")).is_equal(...)")
		lines.append("\t# Final state at tick %d:" % bundle.end_tick())
		var flat := ReplayDiff.flatten(final_state)
		var shown := 0
		for key: String in flat:
			if shown == MAX_STATE_LINES:
				lines.append("\t#   ... %d more fields" % (flat.size() - shown))
				break
			lines.append("\t#   %s = %s" % [key, ReplayDiff.format_value(flat[key])])
			shown += 1
		lines.append("\tassert_that(state).is_not_empty()")
	else:
		for field in fields:
			lines.append_array(_assertions(field, ReplayDiff.field(final_state, field)))
	return "\n".join(lines) + "\n"


static func _assertions(field: String, value: Variant) -> PackedStringArray:
	var out := PackedStringArray()
	var getter := "ReplayTestKit.field(state, %s)" % JSON.stringify(field)
	if value is float or value is int:
		out.append("\tassert_float(float(%s)).is_equal_approx(%s, 0.01)" % [getter, _number(value)])
	elif value is Array:
		out.append("\tassert_int((%s as Array).size()).is_equal(%d)" % [getter, (value as Array).size()])
		for i in (value as Array).size():
			out.append_array(_assertions("%s.%d" % [field, i], value[i]))
	elif value is Dictionary:
		for key: Variant in value:
			out.append_array(_assertions("%s.%s" % [field, key], value[key]))
	elif value == null:
		out.append("\tassert_that(%s).is_null()  # the field was missing in the replay's final state" % getter)
	else:
		out.append("\tassert_that(%s).is_equal(%s)" % [getter, var_to_str(value)])
	return out


static func _number(value: Variant) -> String:
	var number := float(value)
	return str(int(number)) + ".0" if number == roundf(number) else String.num(number, 4)


static func _identifier(text: String) -> String:
	var out := ""
	for c in text.to_lower():
		out += c if (c >= "a" and c <= "z") or (c >= "0" and c <= "9") else "_"
	return out


static func _to_res(path: String) -> String:
	if path.begins_with("res://"):
		return path
	var localized := ProjectSettings.localize_path(path.replace("\\", "/"))
	return localized if localized.begins_with("res://") else ""
